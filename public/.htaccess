# My Custom Beats — Apache / LiteSpeed configuration
#
# Copied verbatim into dist/ by the Vite build, so this file is the source of
# truth. Edit it here, never in dist/.

# ---------------------------------------------------------------------------
# 1. SPA routing
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical host. MUST stay above every rule below.
  #
  # The whole site answered 200 on both mycustombeats.com and
  # www.mycustombeats.com, so every page existed at two URLs. Only the
  # rendered canonical tag told Google which one counted, which is why Search
  # Console filed the apex as "Alternate page with proper canonical tag" — it
  # worked, but it left the duplicate reachable and depended on JavaScript
  # rendering to resolve it. A 301 settles it at the server.
  #
  # $1 carries the path and mod_rewrite appends the original query string, so
  # /products and /legal/terms?x=1 both survive. Only the bare apex matches,
  # so the redirect target can never match again and cannot loop. HTTPS is
  # already enforced upstream and is deliberately not touched here: this host
  # terminates TLS at a proxy, where testing %{HTTPS} can loop.
  RewriteCond %{HTTP_HOST} ^mycustombeats\.com$ [NC]
  RewriteRule ^(.*)$ https://www.mycustombeats.com/$1 [R=301,L]

  RewriteRule ^index\.html$ - [L]

  # Retired route. "The Full Package" is now Bespoke, and its canonical page
  # is /bespoke. A 301 rather than a client-side redirect alone, so links
  # already shared and any crawled URL consolidate onto the new address.
  #
  # mod_rewrite appends the original query string, so ?ref= and ?partner=
  # attribution survives the hop. The trailing slash is optional. The target
  # cannot match again, so this cannot loop. The client router also redirects
  # /full-package, for any host that does not honour this file.
  RewriteRule ^full-package/?$ /bespoke [R=301,L]

  # Build output must NEVER fall through to index.html.
  #
  # Without this, a request for a chunk that is no longer on the server
  # returned "200 OK" with the HTML shell as its body. The browser then
  # failed to parse that HTML as a JavaScript module, which surfaced as
  # "Failed to fetch dynamically imported module" — the blank-page symptom —
  # while every automated check saw a healthy 200. Letting these 404 makes a
  # broken or partial upload immediately visible instead of silently fatal.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^assets/ - [L,R=404]

  # The API is server-side. Without this, an extensionless endpoint such as
  # /api/order is not a real file, so the SPA catch-all below would answer it
  # with index.html and the caller would parse a web page as JSON.
  RewriteRule ^api/ - [L]

  # One URL per page (Sprint 6): /bespoke/ and /bespoke are the same page, so
  # the trailing-slash form 301s to the canonical one. Real directories are
  # left alone. The query string is kept.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # ---- CLIENT ROUTES, AND ONLY CLIENT ROUTES -------------------------------
  #
  # A path the app actually serves is answered with the SPA shell and 200.
  # Anything else falls through to the ErrorDocument below and is answered with
  # the same shell but a real 404 — so the React catch-all still renders the
  # MCB "not found" page, and the status line finally agrees with it.
  #
  # Before this, every unknown path ("/nope", "/old-page.html") returned 200
  # with the 404 UI: a soft 404. Search engines index soft 404s, monitoring
  # cannot see them, and a mistyped internal link looked healthy.
  #
  # THIS LIST MUST MATCH src/App.tsx. tests/website-closure.test.mjs compares
  # the two in both directions and fails if either gains a route the other does
  # not have — otherwise a new page would silently 404 in production, which is
  # a worse failure than the one being fixed.
  RewriteCond %{REQUEST_URI} "^/$" [OR]
  RewriteCond %{REQUEST_URI} "^/(products|create|moment|keepsake|journey|bespoke|full-package|cruise|occasions|anniversary-song|mcb-live|priority-replacement|about|faq|contact|blog|press|artists|partners|affiliate|dashboard|thank-you|your-order|approve|operations|command-centre|artist-thank-you|partner-thank-you)/?$" [OR]
  RewriteCond %{REQUEST_URI} "^/(legal/(terms|privacy|refund)|artists/apply|operations/customer-care)/?$" [OR]
  RewriteCond %{REQUEST_URI} "^/blog/[a-z0-9-]+/?$"
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# ---------------------------------------------------------------------------
# GENUINELY UNKNOWN PATHS RETURN 404 — with the app, so the customer still sees
# MCB's own "not found" page rather than the host's.
#
# ErrorDocument with a LOCAL path is an internal subrequest, not a redirect, so
# there is no HTTP round trip and no possibility of a loop. (A full URL here
# WOULD become a 302 and could loop; that is why this is a path.)
# ---------------------------------------------------------------------------
ErrorDocument 404 /index.html

# ---------------------------------------------------------------------------
# 1b. Security headers (Sprint 6)
# ---------------------------------------------------------------------------
# Content-Security-Policy lists every origin the site genuinely uses:
#   script   self + Google Analytics (gtag.js). NO inline scripts: the GA
#            bootstrap is /analytics-init.js. JSON-LD blocks are data, not
#            script, and are unaffected.
#   style    self + Google Fonts CSS; 'unsafe-inline' because UI components
#            set inline styles. (Styles cannot run code.)
#   font     Google Fonts files
#   img      self, data:/blob: (photo previews), the affiliate QR code image,
#            Google Analytics pixels
#   connect  self (the API) + Google Fonts + Google Analytics collection
#            (analytics.google.com, www.google.com, *.google-analytics.com)
#            + the existing Formspree, Google Apps Script and Zapier forms.
#            Google Signals' regional ga-audiences pixel (google.co.uk etc.)
#            is deliberately NOT allowed: advertising features have no
#            consent basis here.
#   recaptcha the Google reCAPTCHA widget on /artists/apply (script + frame)
#   frames   only reCAPTCHA; the site may only be framed by itself
# Stripe Checkout is a full-page redirect, which CSP does not restrict.
# Verify in production with the browser console before relying on it; see
# docs/SECURITY-NOTES.md.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://api.qrserver.com https://*.google-analytics.com https://*.googletagmanager.com https://www.google.com; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com https://*.googletagmanager.com https://www.google.com https://stats.g.doubleclick.net https://formspree.io https://script.google.com https://script.googleusercontent.com https://new-form-project-54e58b.zapier.app; media-src 'self' blob:; frame-src https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"

  # (THE_REQUEST, not REQUEST_URI: SPA routes are internally rewritten to
  # /index.html, and the original path must still decide.)
  # Private and non-content routes are never indexed. robots.txt asks
  # crawlers not to fetch them; this header covers anything that does. Neither
  # is access control — that is the token and CRM-key checks on the server.
  <If "%{THE_REQUEST} =~ m#^[A-Z]+ /(your-order|approve|operations|command-centre|thank-you|dashboard|artist-thank-you|partner-thank-you|create|artists|affiliate|api/)#">
    Header always set X-Robots-Tag "noindex, nofollow"
  </If>
  # /luxury/ is a separate, unlinked hospitality showcase that uses stock
  # photographs from images.unsplash.com. It gets its own policy allowing that
  # host, and is kept out of search (see docs/SECURITY-NOTES.md).
  <If "%{THE_REQUEST} =~ m#^[A-Z]+ /luxury(/|[ ?])#">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://images.unsplash.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
    Header always set X-Robots-Tag "noindex, nofollow"
  </If>
  <If "%{THE_REQUEST} =~ m#^[A-Z]+ /(your-order|approve|operations|command-centre)#">
    Header always set Referrer-Policy "no-referrer"
    # Private customer and staff screens (17 Sept hardening): no analytics, form or
    # captcha origins at all, and they can never be framed (no clickjacking of a
    # founder's authorisation or a customer's order page). Songs and videos play
    # from same-origin signed URLs and blob: previews.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; media-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    Header always set X-Frame-Options "DENY"
    Header always set Cache-Control "no-store"
  </If>

  # HSTS — PREPARED, OFF BY DEFAULT, ENABLED BY CONFIGURATION.
  #
  # It is no longer a commented-out line someone has to remember to edit: the
  # header is sent only when the host sets the environment variable MCB_HSTS,
  # which can be done from the hosting panel or a SetEnv above without editing
  # this file. With the variable unset — the state MCB ships in — nothing is
  # sent, so a host that is not fully HTTPS cannot be locked out by a deploy.
  #
  # To enable, once EVERY mycustombeats.com host MCB uses is confirmed HTTPS:
  #     SetEnv MCB_HSTS 1
  # Start without includeSubDomains and without preload; both are effectively
  # irreversible for as long as the max-age lasts. See docs/SECURITY-NOTES.md.
  <If "%{ENV:MCB_HSTS} == '1'">
    Header always set Strict-Transport-Security "max-age=31536000"
  </If>
</IfModule>

# ---------------------------------------------------------------------------
# 2. Caching
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>

  # The application shell must always be revalidated.
  #
  # It previously carried no Cache-Control at all, so browsers applied
  # heuristic freshness (roughly a tenth of the time since Last-Modified).
  # With a shell several weeks old that is days of caching, which is how a
  # visitor ends up running an old index.html against a newly deployed asset
  # set: stale chunk names, missing modules, blank pages, and an old logo
  # from the previously cached bundle.
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Build output is content-hashed: a change to the file changes its name,
  # so these can be cached indefinitely and never go stale.
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images, audio, video and fonts under public/ keep stable filenames, so
  # they are cached for a day and then revalidated rather than pinned.
  <FilesMatch "\.(png|jpe?g|gif|svg|webp|avif|ico|mp3|mp4|webm|woff2?)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>

  # Crawler-facing files should not be pinned either.
  <FilesMatch "^(robots\.txt|sitemap\.xml)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

</IfModule>

# ---------------------------------------------------------------------------
# 3. Compression
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>
